# Variables de entorno para SG-SST Generator
# Copia este archivo como .env y completa con tus valores reales
# NUNCA subas el archivo .env real al repositorio

# --- Claude API (Anthropic) ---
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de Claude a usar (recomendado: Haiku para velocidad/costo)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Precios actuales por millón de tokens (USD)
# Verificar en https://docs.anthropic.com/en/docs/about-claude/pricing
CLAUDE_PRECIO_INPUT=1
CLAUDE_PRECIO_OUTPUT=5

# --- Rutas (opcional - usa defaults si las omites) ---
# PLANTILLA_PATH=Plantilla SG-SST 2026
# OUTPUT_BASE_PATH=clientes
# CACHE_DIR=.cache
# CACHE_EXPIRY_DAYS=30
